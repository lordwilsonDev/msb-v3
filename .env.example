MSB_HOST=127.0.0.1
MSB_PORT=8766
MSB_RELOAD=0
MSB_REASONING_SCORER=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
MSB_DB_PATH=data/msb_v3.db
MSB_LOG_LEVEL=info

# Alternative inference backend — llama.cpp (llama-server) on :8080, used
# when MSB_ACTIVE_BACKEND=llamacpp. UNPROVISIONED as of 2026-08-20: the
# gemma-4-12b-it weights were removed to free disk (see project-map §18);
# LLAMA_CPP_MODEL now points at a path that does not exist, so this backend
# is unsupported until weights are re-provisioned. /system/health reports it
# red (fail-closed) — MSB_ACTIVE_BACKEND stays ollama.
LLAMA_CPP_URL=http://127.0.0.1:8080
LLAMA_CPP_MODEL=~/models/gemma-4-12b-it/gemma-4-12b-it-q4_k_m.gguf
MSB_ACTIVE_BACKEND=ollama

# Paths — all default sensibly, so none of these need setting on a standard
# checkout. Repo root (Python reads MSB_HOME then MSB_REPO; shell scripts use
# MSB_REPO): if unset, derived from the package/script location.
MSB_HOME=
# Vault root for the MCP bridge vault_* tools (default ~/Documents/Vault).
MSB_VAULT_PATH=
# NotebookLM active-cluster index for /knowledge/active-cluster
# (default ~/notebooklm-library-deep-dive/active-index.json).
NOTEBOOKLM_ACTIVE_INDEX=
# Shared secret required for a caller to be classified as the human-operator
# role (wildcard access) in the Guardian least-privilege check. Leave unset
# to deny that role entirely (safe default) rather than granting it to any
# unrecognized token.
MSB_OPERATOR_TOKEN=

# MCP bridge + /chat + /memory shared secret, sent as `x-mcp-secret`.
# Required: start.sh refuses to boot without it, and the auth gate returns
# 401 on mismatch. Generate with: openssl rand -hex 32
MCP_BRIDGE_SECRET=
# Standing capability grant for MCP bridge callers (M2/P1). Empty = read-only:
# vault_* mutations are denied + audited with a verdict unless granted. To let
# Make.com workflows write the vault, set e.g.: vault.write
MSB_MCP_GRANTED_CAPABILITIES=
# Optional key sent as X-API-Key by the RAG ingest scripts (scripts/ingest/*).
MSB_RAG_API_KEY=

# Out-of-band chain-anchor notary log (append-only JSONL outside the repo).
# The daily chain-anchor verify job checks its last entry against the live
# chain when set, so a whole-DB rollback is caught even if the local anchor
# file is also replaced. Must match scripts/notarize_chain_anchor.sh.
MSB_NOTARY_LOG=${HOME}/msb-backups/chain-anchor-notary.jsonl

# Off-box notary sink (#2): an rclone remote DIRECTORY where each notarized
# entry is pushed as its OWN immutable object ({seq}-{ts}.line), so a remote
# cannot be silently shrunk by re-pushing (missing seqs are detected) and
# overwrites break the signature. Verify reads the REMOTE head, never the
# local last line. Point this at object-lock / WORM storage (S3 Object Lock,
# B2, ...) for true immutability; gdrive: is mutable but still off-box.
# Empty or "none" disables the remote push (local-only, not off-box).
MSB_NOTARY_REMOTE=gdrive:msb-v3/chain-anchor-notary

# RFC 3161 trusted timestamping (#9): when set, every notarized entry is
# stamped by this TSA (third-party WHEN; the raw token is stored and
# re-verifiable). Leave empty for receive-time only (the notary's own clock).
# Public TSAs: https://timestamp.digicert.com, http://freetsa.org/tsr,
# https://timestamp.sectigo.com. Fail-closed: an unreachable/failed TSA makes
# notarization fail loudly unless you opt into the weaker receive-time
# fallback below.
# MSB_TSA_URL=https://timestamp.digicert.com
# MSB_TSA_ALLOW_LOCAL_FALLBACK=1

# FAIL-CLOSED audit chain: a bare AuditChain() append is REFUSED when (1)
# the target chain carries a signed anchor file (chain_anchor.json next to
# the DB — a property of the CHAIN, so even keyless processes are refused)
# or (2) MSB_CHAIN_ANCHOR_KEY is configured (set in the real .env, never
# committed) and the append targets the default production chain. External
# automation must use anchored_chain_from_env() so every append re-anchors.
# Only set MSB_ALLOW_KEYLESS_APPENDS=1 to explicitly opt OUT of that guard
# (dev/test or a legacy process mid-migration; DO NOT set in production).
# MSB_ALLOW_KEYLESS_APPENDS=1

# Sovereign Node (first vertical slice): signed iPhone sessions and a scoped
# read-only filesystem sandbox. Keep the pairing code short-lived and rotate
# it after enrollment; empty means enrollment is closed.
MSB_NODE_DB_PATH=data/node/node.db
MSB_NODE_AUDIT_DB_PATH=data/node/audit_chain.db
MSB_NODE_SANDBOX_ROOT=runtime/node-sandbox
MSB_NODE_PAIRING_CODE=
MSB_NODE_SESSION_TTL_S=900
MSB_NODE_CLOCK_SKEW_S=60
MSB_NODE_MAX_READ_BYTES=1048576

# Vesta transport admission. Keep disabled for local development. Production
# enables tunnel-only mode after WireGuard and firewall verification; the
# application trusts only the direct peer address, never forwarded headers.
MSB_VESTA_REQUIRE_TUNNEL=0
MSB_VESTA_ALLOWED_CIDRS=127.0.0.1/32,::1/128
MSB_VESTA_TASK_DB_PATH=data/vesta/tasks.db
MSB_VESTA_EVIDENCE_ROOT=runtime/vesta-evidence
MSB_VESTA_EVIDENCE_DB_PATH=data/vesta/evidence.db
# SHELL_EXEC remains approval-only. The initial allowlist is echo/pwd, with
# no shell interpolation, no network capability, bounded runtime, and bounded
# captured output.
MSB_VESTA_SHELL_TIMEOUT_S=10.0
MSB_VESTA_SHELL_MAX_OUTPUT_BYTES=65536

# OpenAI-compatible /v1 adapter (Open WebUI and other OpenAI SDK clients).
# Fail-closed: while unset, GET /v1/models and POST /v1/chat/completions
# return 503. Set to any string and send it as `Authorization: Bearer <key>`.
# With a REMOTE frontier seam (below) this is the provider's real API key
# (e.g. a DeepSeek sk-... key) — the same key also authenticates to the
# runtime's own /v1 adapter (single-secret design).
OPENAI_API_KEY=
# Hybrid model-router frontier seam (Phase 2): URL of the /v1 adapter +
# model id used for long-horizon plan/verify-synth work. Router degrades to
# local until OPENAI_API_KEY is set.
# LOCKED 2026-08-12: DeepSeek is the frontier provider for the
# planning/verification slice (OpenAI-compatible API — no adapter needed).
# Self-hosted alternative: the runtime's own loopback adapter
# (OPENAI_FRONTIER_URL=http://127.0.0.1:8766/v1 with any OPENAI_API_KEY).
OPENAI_FRONTIER_URL=https://api.deepseek.com/v1
OPENAI_FRONTIER_MODEL=deepseek-v4-flash
# DeepSeek native API provider (AgentProvider ABC, kind="api"). Explicit
# overrides for the dedicated DeepSeek provider; they default to the frontier
# seam values above, and DEEPSEEK_API_KEY falls back to OPENAI_API_KEY
# (single-secret design).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama embedding model used by the native /rag provider (and therefore
# exposed via POST /v1/embeddings). Must be pulled in Ollama (`ollama pull
# nomic-embed-text`).
OLLAMA_EMBED_MODEL=nomic-embed-text

# Cron scheduler (the heartbeat) — scheduled governed jobs, see
# docs/cron-scheduler.md. The in-process loop starts on boot when enabled;
# the CLI (python -m msb_v3.cron) still runs jobs on demand regardless.
MSB_CRON_ENABLED=1
MSB_CRON_TICK_S=15
# Job + run history store; empty derives from MSB_DB_PATH (data/runtime/cron.db).
MSB_CRON_DB_PATH=
MSB_CRON_HISTORY_KEEP=100
# http_call host allowlist — fail-closed: a URL whose host is not listed is
# refused. Default loopback only; add hosts (no scheme/port) to widen.
MSB_CRON_HTTP_HOSTS=127.0.0.1,localhost,::1

# --- Wake loop (the 5-minute resident agent) — see docs/wake-loop.md ---
# A governed cron job (wake-agent, seeded on server start) wakes the resident
# agent to process messages left in the wake inbox from ANY session
# (POST /wake); replies land in the outbox (GET /wake/outbox). Enabled by
# default; the inbox/outbox store derives from MSB_DB_PATH.
MSB_WAKE_ENABLED=1
MSB_WAKE_DB_PATH=
MSB_WAKE_MAX_PER_RUN=5
MSB_WAKE_SCHEDULE=*/5 * * * *

# --- Automation brain (n8n / Make / Zapier / GoHighLevel) — see
#     docs/automation-brain.md ---
# The brain (DeepSeek-driven) creates automations from a plain-language
# request. Dry-run by default: creation requires approve=true on the request
# (the operator token IS the approval) or MSB_AUTOMATION_DRY_RUN=0.
MSB_AUTOMATION_BUDGET_USD=10.0
MSB_AUTOMATION_DRY_RUN=1
MSB_AUTOMATION_MANIFEST_PATH=
# The /hook webhook sense: optional shared secret for inbound payloads
# (x-hook-secret header, constant-time compare). Empty = open to bounded
# payloads only — the brain judges what arrives. Generate: openssl rand -hex 16
MSB_AUTOMATION_HOOK_SECRET=
# Dispatcher outbound allowlist: hosts living automations may POST to beyond
# loopback + the providers' own hosts (comma-separated, no scheme/port).
# Empty = loopback + providers only (fail-closed).
MSB_AUTOMATION_WEBHOOK_HOSTS=
# n8n is the first-class target (self-hosted, free). Create the API key in
# n8n: Settings → API. Make / Zapier / GoHighLevel activate as their keys
# are set — the brain reports them as blocked-with-reason until then.
N8N_API_KEY=
N8N_BASE_URL=http://127.0.0.1:5678
MSB_MAKE_WEBHOOK_URL=
MSB_ZAPIER_API_KEY=
MSB_GHL_API_KEY=
MSB_GHL_BASE_URL=https://services.leadconnectorhq.com

# /v1/embeddings guards: max items per request (413 when exceeded) and max
# total items per client within the window (429 when exceeded). A batch of N
# consumes N units toward the window cap.
OPENAI_EMBED_MAX_BATCH=32
OPENAI_EMBED_RATE_MAX=120
OPENAI_EMBED_RATE_WINDOW_S=60

# Open WebUI document RAG -> MSB embeddings. Fixed in the compose service;
# listed here so the contract is visible. RAG_OPENAI_API_* fall back to the
# OPENAI_* connection, and RAG_EMBEDDING_MODEL must be a model Ollama has
# pulled for the adapter's /v1/embeddings (default nomic-embed-text, 768d).
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=nomic-embed-text

# Open WebUI session/encryption signing key. Leave empty to let Open WebUI
# auto-generate one (persisted in its volume); or set your own:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# Open WebUI S3 storage via Tencent COS (S3-compatible). Used by the
# open-webui service in docker-compose.sovereign.yml; the adapter itself
# never touches these. To enable: fill all five TENCENT_COS_* vars AND set
# STORAGE_PROVIDER=s3 (default is local — an empty provider crashes Open
# WebUI at boot).
STORAGE_PROVIDER=local
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=

# --- Ops resilience slots (close-out blueprint / project-map §18) ---
# Out-of-band alert channels for ops failures (weekly self-audit, backup
# watchdog). All channels fail-soft — a missing/broken channel is logged to
# logs/ops-alerts.log, never fatal. Fill any combination:
#   MSB_ALERT_EMAIL=<you@example.com>   (uses /usr/bin/mail)
#   MSB_TELEGRAM_BOT_TOKEN + MSB_TELEGRAM_CHAT_ID
MSB_ALERT_EMAIL=
MSB_TELEGRAM_BOT_TOKEN=
MSB_TELEGRAM_CHAT_ID=
# Liveness + off-machine copy of the ops trail (scripts/heartbeat.sh, daily
# 12:00). Two sink options, either or both:
#   MSB_HEARTBEAT_RCLONE_REMOTE — rclone remote dir (e.g.
#     gdrive:msb-v3/heartbeat); content is staged locally and pushed, so no
#     external hardware is needed. A configured remote that fails to push
#     exits 1 (loud).
#   MSB_HEARTBEAT_DIR — an EXTERNAL volume mount, e.g. /Volumes/BackupDrive.
# Unset = heartbeat skips (documented config state, not a failure).
MSB_HEARTBEAT_RCLONE_REMOTE=
MSB_HEARTBEAT_DIR=
# Mirror the repo incl. .git (signed history + audit trail) to a second node
# (scripts/replicate-to-secondary.sh, Sun 07:05). Format: user@host:/path
# (rsync over ssh) or /local/path (same-machine test). Unset = replication
# skips; configured but unreachable = LOUD (watchdog alert, exit 1).
MSB_REPLICATION_TARGET=

# OpenBot adapter (MSB-side bridge; supervisor owns Docker and remains fail-closed)
OPENBOT_SUPERVISOR_URL=http://127.0.0.1:4300
OPENBOT_SUPERVISOR_TOKEN=
OPENBOT_TIMEOUT=10

# DeepSeek Harness (dsh) — governed subprocess agent. DSH_BINARY is the
# executable or prefix ("dsh", "npx @deepseek-ai/dsh", "pnpm dsh");
# DSH_PROFILE selects the dsh profile (default "headless"). Unset or
# unresolved = provider unavailable (fail-closed).
DSH_BINARY=dsh
DSH_PROFILE=headless
DSH_TIMEOUT_S=600
