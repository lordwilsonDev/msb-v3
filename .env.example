MSB_HOST=127.0.0.1
MSB_PORT=8766
MSB_RELOAD=0
MSB_REASONING_SCORER=1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
MSB_DB_PATH=data/msb_v3.db
MSB_LOG_LEVEL=info

# Paths — all default sensibly, so none of these need setting on a standard
# checkout. Repo root (Python reads MSB_HOME then MSB_REPO; shell scripts use
# MSB_REPO): if unset, derived from the package/script location.
MSB_HOME=
# Vault root for the MCP bridge vault_* tools (default ~/Documents/Vault).
MSB_VAULT_PATH=
# NotebookLM active-cluster index for /knowledge/active-cluster
# (default ~/notebooklm-library-deep-dive/active-index.json).
NOTEBOOKLM_ACTIVE_INDEX=
# Shared secret required for a caller to be classified as the human-operator
# role (wildcard access) in the Guardian least-privilege check. Leave unset
# to deny that role entirely (safe default) rather than granting it to any
# unrecognized token.
MSB_OPERATOR_TOKEN=

# OpenAI-compatible /v1 adapter (Open WebUI and other OpenAI SDK clients).
# Fail-closed: while unset, GET /v1/models and POST /v1/chat/completions
# return 503. Set to any string and send it as `Authorization: Bearer <key>`.
# With a REMOTE frontier seam (below) this is the provider's real API key
# (e.g. a DeepSeek sk-... key) — the same key also authenticates to the
# runtime's own /v1 adapter (single-secret design).
OPENAI_API_KEY=
# Hybrid model-router frontier seam (Phase 2): URL of the /v1 adapter +
# model id used for long-horizon plan/verify-synth work. Router degrades to
# local until OPENAI_API_KEY is set.
# LOCKED 2026-08-12: DeepSeek is the frontier provider for the
# planning/verification slice (OpenAI-compatible API — no adapter needed).
# Self-hosted alternative: the runtime's own loopback adapter
# (OPENAI_FRONTIER_URL=http://127.0.0.1:8766/v1 with any OPENAI_API_KEY).
OPENAI_FRONTIER_URL=https://api.deepseek.com/v1
OPENAI_FRONTIER_MODEL=deepseek-v4-flash

# Ollama embedding model used by the native /rag provider (and therefore
# exposed via POST /v1/embeddings). Must be pulled in Ollama (`ollama pull
# nomic-embed-text`).
OLLAMA_EMBED_MODEL=nomic-embed-text

# /v1/embeddings guards: max items per request (413 when exceeded) and max
# total items per client within the window (429 when exceeded). A batch of N
# consumes N units toward the window cap.
OPENAI_EMBED_MAX_BATCH=32
OPENAI_EMBED_RATE_MAX=120
OPENAI_EMBED_RATE_WINDOW_S=60

# Open WebUI document RAG -> MSB embeddings. Fixed in the compose service;
# listed here so the contract is visible. RAG_OPENAI_API_* fall back to the
# OPENAI_* connection, and RAG_EMBEDDING_MODEL must be a model Ollama has
# pulled for the adapter's /v1/embeddings (default nomic-embed-text, 768d).
RAG_EMBEDDING_ENGINE=openai
RAG_EMBEDDING_MODEL=nomic-embed-text

# Open WebUI session/encryption signing key. Leave empty to let Open WebUI
# auto-generate one (persisted in its volume); or set your own:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# Open WebUI S3 storage via Tencent COS (S3-compatible). Used by the
# open-webui service in docker-compose.sovereign.yml; the adapter itself
# never touches these. To enable: fill all five TENCENT_COS_* vars AND set
# STORAGE_PROVIDER=s3 (default is local — an empty provider crashes Open
# WebUI at boot).
STORAGE_PROVIDER=local
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
