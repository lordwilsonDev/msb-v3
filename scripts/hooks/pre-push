#!/usr/bin/env bash
# pre-push — run the lint + policy + portability gates before any push lands.
#
# TRACKED SOURCE OF RECORD (scripts/hooks/pre-push). .git/hooks is not cloned
# or pushed, so a fresh clone has no hook until scripts/setup.sh installs it
# from here. Edit this file, re-run setup (or copy it over .git/hooks/pre-push
# by hand) — never edit the installed copy alone.
#
# Git invokes this hook for every `git push` (including pushes to scratch
# remotes). It runs two gates in order:
#   1. lint (`make lint`: ruff + mypy + lock/claim checks + the MoIE policy
#      drift gate) — cheap; blocks type/import regressions and any policy
#      edit that drifts detection coverage from the pinned baseline
#   2. portability (`make portability`): stage the repo to a temp copy, scan
#      for /Users/... machine literals in live code, and run the full pytest
#      suite from the foreign path.
# A failing gate blocks the push.
#
#   MSB_SKIP_PORTABILITY=1 git push ...    # explicit escape hatch
#
# Note: the gate tests the WORKING TREE the push is made from (same as
# `make portability`), not just the commits being pushed — unrelated local
# edits can block a push. From a linked worktree, the gate runs in THAT
# worktree (fixed 2026-10-04; it used to gate the main checkout instead).
#
# Exit 0 = gate green, push proceeds. Non-zero = push blocked.
set -euo pipefail

# 2026-10-04 fixes (history: PZS 30_BUGS/pre-push-hook-gates-stale-worktree-claims-drift.md):
#
# 1. WORKTREE RESOLUTION. Git runs hooks with cwd at the root of the
#    working tree the push is made from, so $PWD is the tree to gate —
#    for the main checkout AND every linked worktree. The earlier
#    "$(dirname BASH_SOURCE)/../.." resolved through the SHARED gitdir
#    (msb-v3/.git), so every worktree push gated whichever checkout
#    holds that gitdir (stale main) instead of the tree being pushed.
#    MSB_REPO still wins for explicit targeting.
# 2. GIT ENV HYGIENE. git seeds hooks with GIT_DIR/GIT_WORK_TREE/etc.
#    pointing at the shared gitdir. Left set, they leak into gate
#    subprocesses: temp-repo fixtures wrote their identity into the
#    shared .git/config (the 2026-10-04 incident). Unset the family up
#    front; git re-discovers the right repo from cwd, and
#    run_staged_suite() keeps its own clearing as defense in depth.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR 2>/dev/null || true

REPO="${MSB_REPO:-$(pwd -P)}"
echo "[pre-push] gating tree: $REPO"

# Not a git work tree? Nothing to gate. (Belt-and-braces: git only runs
# hooks from a work tree, but a stale/foreign copy shouldn't hard-fail.)
git -C "$REPO" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0

if [ "${MSB_SKIP_PORTABILITY:-0}" = "1" ]; then
  echo "[pre-push] MSB_SKIP_PORTABILITY=1 — skipping portability gate"
  exit 0
fi

cd "$REPO"

# Fast lint + type + policy gate first (the exact gates CI's lint job runs):
# cheap, and catches the unused-import / type-error regressions a green test
# suite cannot see, plus any MoIE policy edit that drifts detection coverage
# from its pinned baseline. A red lint job must never be pushed — it would
# turn CI red.
echo "[pre-push] lint gate (ruff + mypy + policy drift)..."
code=0
if [ -f Makefile ] && make -n lint >/dev/null 2>&1; then
  make lint || code=$?
else
  python3 -m ruff check src/ tests/ || code=$?
  if [ "$code" -eq 0 ]; then
    # Bare mypy — no blanket --ignore-missing-imports (it masked the P4
    # extraction's red state; targeted overrides live in pyproject.toml).
    python3 -m mypy src || code=$?
  fi
  # No-Makefile fallback (foreign clone) must still run the policy drift
  # gate — the `make lint` path covers it when a Makefile exists.
  if [ "$code" -eq 0 ]; then
    bash scripts/ci-policy-gate.sh || code=$?
  fi
fi
if [ "$code" -ne 0 ]; then
  echo "[pre-push] LINT GATE FAILED — push blocked"
  echo "[pre-push]   fix the lint/type/policy errors above, then re-push."
  echo "[pre-push]   to push anyway: MSB_SKIP_PORTABILITY=1 git push"
  exit "$code"
fi
echo "[pre-push] lint gate PASS"

echo "[pre-push] running portability gate before push..."
echo "[pre-push]   (bypass with: MSB_SKIP_PORTABILITY=1 git push)"
start=$(date +%s)

# Prefer the Makefile target (what the gate is documented as); fall back to
# the script directly on a checkout without the target (foreign clone).
# `|| code=$?` (not a bare call): under `set -e` the failing gate command
# would exit the hook before the summary lines below ever printed.
code=0
if [ -f Makefile ] && make -n portability >/dev/null 2>&1; then
  make portability || code=$?
else
  bash scripts/portability-check.sh || code=$?
fi

elapsed=$(( $(date +%s) - start ))
if [ "$code" -eq 0 ]; then
  echo "[pre-push] portability gate PASS (${elapsed}s) — push proceeds"
else
  echo "[pre-push] PORTABILITY GATE FAILED (${elapsed}s) — push blocked"
  echo "[pre-push]   fix the failure above, then re-push."
  echo "[pre-push]   to push anyway: MSB_SKIP_PORTABILITY=1 git push"
fi
exit "$code"
