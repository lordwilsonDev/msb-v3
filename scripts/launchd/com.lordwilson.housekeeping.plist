<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lordwilson.housekeeping</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lordwilson/projects/AI-Agents/msb-v3/scripts/housekeeping.sh</string>
  </array>

  <!-- Daily 06:40: rotate-logs every day; cache-trim then disk-health added
       on Sunday only (housekeeping.sh gates on day-of-week). Replaces the
       three separate rotate-logs/cache-trim/disk-health agents. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ThrottleInterval</key><integer>600</integer>

  <key>StandardErrorPath</key><string>/Users/lordwilson/projects/AI-Agents/msb-v3/logs/housekeeping.err</string>
  <key>WorkingDirectory</key><string>/Users/lordwilson/projects/AI-Agents/msb-v3</string>
</dict>
</plist>
