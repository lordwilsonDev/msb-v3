<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lordwilson.ops-audit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lordwilson/msb-v3/scripts/ops-audit.sh</string>
  </array>

  <!-- Weekly Sunday 06:50 — the last step of the Sunday cascade (after
       disk-health 06:45). Full ops self-audit; a non-zero exit alerts via
       the backup watchdog. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>50</integer>
  </dict>

  <!-- Self-publish the dated audit report (audit/<date>_audit.md) to
       origin each Sunday. Set MSB_ALERT_EMAIL / MSB_TELEGRAM_BOT_TOKEN /
       MSB_TELEGRAM_CHAT_ID to also alert on failure via email/Telegram.
       NOTE: deliberately NOT KeepAlive — this is a weekly scheduled job;
       KeepAlive would relaunch it in an endless loop. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>MSB_PUBLISH_AUDIT</key><string>1</string>
    <!-- <key>MSB_ALERT_EMAIL</key><string>you@example.com</string> -->
    <!-- <key>MSB_TELEGRAM_BOT_TOKEN</key><string>123456:ABC-DEF</string> -->
    <!-- <key>MSB_TELEGRAM_CHAT_ID</key><string>123456789</string> -->
  </dict>

  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ThrottleInterval</key><integer>600</integer>

  <key>StandardErrorPath</key><string>/Users/lordwilson/msb-v3/logs/ops-audit.err</string>
  <key>WorkingDirectory</key><string>/Users/lordwilson/msb-v3</string>
</dict>
</plist>
